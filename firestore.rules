rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        );
    }

    match /astro_stories/{storyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, delete: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();

      match /tarotData/{doc} {
        allow read, write: if isOwner(userId);
      }

      // Kozmik Rehber sohbet geçmişi
      match /kozmikRehberChats/{chatId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      // Kozmik Rehber global hafıza (çapraz sohbet tutarlılığı için)
      match /kozmikRehberMemory/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /supportMessages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.contactEmail is string
        && request.resource.data.subject is string
        && request.resource.data.question is string
        && request.resource.data.message is string
        && request.resource.data.isRead == false
        && request.resource.data.status == "new";

      allow read, update, delete: if isAdmin();
    }

    match /advisor_chats/{chatId} {
      // Kullanici kendi chatini olusturabilir; admin herhangi bir user icin olusturabilir
      allow create: if signedIn()
        && (request.resource.data.userId == request.auth.uid || isAdmin());

      allow read, update: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }

    match /free_consultations/{grantId} {
      // Sadece admin yazabilir; ilgili kullanici veya admin okuyabilir
      allow create, update, delete: if isAdmin();
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
    }

    match /weekly_horoscopes_general/{sign} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Uygulama konfigürasyonu — herkese açık okuma (zorunlu güncelleme kontrolü için)
    match /app_config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Kullanıcı aktivite takibi — kullanıcı kendi verisini yazar, admin okur
    match /user_activity/{userId} {
      allow write: if isOwner(userId);
      allow read: if isAdmin();

      match /events/{eventId} {
        allow create: if isOwner(userId);
        allow read: if isAdmin();
      }
    }

    // Global analitik sayaçlar — oturum açmış her kullanıcı yazar, admin okur
    match /analytics/{doc} {
      allow write: if signedIn();
      allow read: if isAdmin();
    }

    // İndirim denemeleri logu
    // Admin panel bu koleksiyonu listeler, uygulama ise create eder.
    match /discount_attempts/{attemptId} {
      // Admin hem get hem list okuyabilsin.
      allow read: if isAdmin();

      // Oturum açmış kullanıcı: sadece kendi uid'si ile yazabilir.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.isAuthenticated == true
        && request.resource.data.isPremiumUser is bool
        && request.resource.data.membershipType in ['premium', 'uye_degil', 'bilinmiyor']
        && request.resource.data.code is string
        && request.resource.data.store in ['app_store', 'google_play']
        && request.resource.data.status in ['success', 'emptyCode', 'invalidCode', 'alreadyUsed', 'failed']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAtClient is timestamp;

      // Misafir denemesi: auth yokken yalnızca misafir şemasında create edilsin.
      allow create: if !signedIn()
        && request.resource.data.uid is string
        && request.resource.data.uid.matches('^misafir_[a-z0-9]+$')
        && request.resource.data.isAuthenticated == false
        && request.resource.data.isPremiumUser == false
        && request.resource.data.membershipType == 'misafir'
        && request.resource.data.code is string
        && request.resource.data.store in ['app_store', 'google_play']
        && request.resource.data.status in ['success', 'emptyCode', 'invalidCode', 'alreadyUsed', 'failed']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAtClient is timestamp;

      allow update, delete: if false;
    }

    // Admin için tüm kullanıcıların kozmik sohbetlerini collectionGroup ile sorgulama
    match /{path=**}/kozmikRehberChats/{chatId} {
      allow read: if isAdmin();
    }
  }
}
